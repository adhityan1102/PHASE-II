{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/PHASE-II/",
  "name": "PHASE - II Revision Companion",
  "short_name": "PHASE - II",
  "description": "Phase 2 study planner and revision companion for Class 10 CBSE students of Sri Chaitanya Techno School, Trichy.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon.png",
      "sizes": "1600x1600",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's Focus",
      "short_name": "Focus",
      "description": "Open Morning, Evening, and FAT cards",
      "url": "./index.html?tab=0",
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Full Schedule",
      "short_name": "Schedule",
      "description": "Browse all 66 sessions and FAT dates",
      "url": "./index.html?tab=1",
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Timer & Error Vault",
      "short_name": "Vault",
      "description": "Practice timer and Dec 1-3 Error Rectification Vault",
      "url": "./index.html?tab=3",
      "icons": [
        {
          "src": "./icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
